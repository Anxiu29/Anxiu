{
  "name": "anxiu-keyboard-driver",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:cb75": "npm run build:cb75 && cd rk-cb75-source && node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "npm run build:cb75 && vue-tsc -b && vite build",
    "build:cb75": "node scripts/build-cb75.mjs",
    "sync:keymap": "node scripts/sync-official-key-map.mjs",
    "test": "vitest run && npm run test:tlw",
    "test:watch": "vitest",
    "type-check": "vue-tsc -b",
    "test:tlw": "node --test tests/tlw/codec.test.cjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.6",
    "@sparklinkplayjoy/protocol-keyboard": "1.0.7",
    "pinia": "^3.0.3",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/w3c-web-hid": "^1.0.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.4"
  }
}
